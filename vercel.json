{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build:site",
  "outputDirectory": "demo/dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/kamiliyon/",
      "permanent": false
    },
    {
      "source": "/colorsbymax",
      "destination": "/kamiliyon/",
      "permanent": true
    },
    {
      "source": "/colorsbymax/:path*",
      "destination": "/kamiliyon/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/kamiliyon/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/kamiliyon/api/:path*",
      "destination": "/api/:path*"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "content": false
    }
  }
}
